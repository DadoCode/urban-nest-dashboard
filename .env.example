# Copy this file to .env and fill in your key (never commit the real .env).
# Optional: without it, document uploads still work but you fill in the
# extracted line items by hand instead of Claude doing it automatically.
ANTHROPIC_API_KEY=

# Optional: turn on a login so the dashboard can be shared safely.
# UN_OWNER_PASSWORD gives full access; UN_VIEWER_PASSWORD is read-only.
# Leave both empty for local-only use with no login.
UN_OWNER_PASSWORD=
UN_VIEWER_PASSWORD=
